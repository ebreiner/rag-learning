{
	"enable_quality_processing": true,
	"output_format": "element_based",
	"ocr": {
		"backend": "tesseract",
		"language": "eng+deu",
		"tesseract_config": {
			"psm": 3,
			"oem": 3,
			"min_confidence": 0.0,
			"output_format": "text",
			"enable_table_detection": false,
			"table_min_confidence": 0.5,
			"table_column_threshold": 50,
			"table_row_threshold_ratio": 0.5,
			"use_cache": true,
			"preprocessing": {
				"target_dpi": 300,
				"auto_rotate": true,
				"deskew": true,
				"denoise": true,
				"contrast_enhance": true,
				"binarization_method": "otsu",
				"invert_colors": false
			}
		}
	},
	"pdf_options": {
		"extract_metadata": true,
		"hierarchy": {
			"enabled": true,
			"k_clusters": 6,
			"include_bbox": true,
			"ocr_coverage_threshold": 0.5
		}
	},
	"chunking": {
		"max_chars": 500,
		"max_overlap": 50,
		"chunker_type": "markdown",
		"embedding": {
			"batch_size": 32,
			"normalize": true,
			"show_download_progress": true,
			"model": {
				"type": "preset",
				"name": "quality"
			}
		}
	},
	"pages": {
		"enabled": true
	},
	"language_detection": {
		"enabled": true,
		"min_confidence": 0.8,
		"detect_multiple": false
	},
	"postprocessor": {
		"enabled": true
	}
}
